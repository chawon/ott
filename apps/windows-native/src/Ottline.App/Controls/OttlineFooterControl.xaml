<UserControl x:Class="Ottline.App.Controls.OttlineFooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Margin="0,40,0,0"
            Padding="0,24,0,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Brand & Tagline -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ottline"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="ON THE TIMELINE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Strings.FooterTagline}"
                               FontSize="12.5"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Right Copyright & Contact -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="© 2026 ottline. All rights reserved."
                               FontSize="11.5"
                               Foreground="{DynamicResource ForegroundMutedBrush}"
                               HorizontalAlignment="Right" />
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0,3,0,0"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            Click="OpenMailto_Click">
                        <TextBlock Text="contact@ottline.app"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   TextDecorations="Underline" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Navigation Links Row (AppFooter.tsx 5 links: Guides, About, FAQ, Privacy, Contact) -->
            <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                <Button Style="{StaticResource GhostButtonStyle}"
                        Content="{Binding Strings.FooterGuidesLink}"
                        Padding="11,6"
                        Margin="0,0,8,6"
                        Click="OpenGuides_Click" />
                <Button Style="{StaticResource GhostButtonStyle}"
                        Content="{Binding Strings.FooterAboutLink}"
                        Padding="11,6"
                        Margin="0,0,8,6"
                        Click="OpenAbout_Click" />
                <Button Style="{StaticResource GhostButtonStyle}"
                        Content="{Binding Strings.FooterFaqLink}"
                        Padding="11,6"
                        Margin="0,0,8,6"
                        Click="OpenFaq_Click" />
                <Button Style="{StaticResource GhostButtonStyle}"
                        Content="{Binding Strings.FooterPrivacyLink}"
                        Padding="11,6"
                        Margin="0,0,8,6"
                        Click="OpenPrivacy_Click" />
                <Button Style="{StaticResource GhostButtonStyle}"
                        Content="{Binding Strings.FooterFeedbackLink}"
                        Padding="11,6"
                        Margin="0,0,0,6"
                        Click="OpenFeedback_Click" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
