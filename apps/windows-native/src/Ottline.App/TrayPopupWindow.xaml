<Window x:Class="Ottline.App.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource OttlineFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="TrayRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBg" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayDangerRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource SemanticDangerBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBg" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="12" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="6" />
        </Grid.RenderTransform>

        <Border Width="268"
                CornerRadius="12"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.20"
                                  Color="#000000"
                                  RenderingBias="Performance" />
            </Border.Effect>

            <StackPanel>
                <!-- 1. Brand Header + Live Status Pill -->
                <Grid Margin="6,4,6,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="96" Height="96">
                                <Path Stroke="{DynamicResource BrandMarkBrush}"
                                      StrokeThickness="8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 14,34 V 28 C 14,22.477 18.477,18 24,18 C 34,18 41.5,21.8 48,27 C 55.8,21.8 65.5,18 77,18 C 82.523,18 87,22.477 87,28 V 64 C 87,69.523 82.523,74 77,74 C 66.5,74 57.2,76.9 51.5,81 M 15,49 L 36.5,62.75 L 15,76.5 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="ottline"
                                   FontSize="16.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="7,-1,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            CornerRadius="10"
                            Background="{DynamicResource CardElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="6"
                                     Height="6"
                                     Fill="{DynamicResource AccentOrangeBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,5,0" />
                            <TextBlock x:Name="StatusTextBlock"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       MaxWidth="118"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Hairline Divider -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,0,4,8" />

                <!-- 3. Primary Quick Record CTA -->
                <Button x:Name="QuickRecordButton"
                        Cursor="Hand"
                        Margin="0,0,0,4"
                        HorizontalContentAlignment="Stretch"
                        Click="QuickRecord_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentOrangeBrush}"
                                    Padding="12,9">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.82" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,5 V 19 M 5,12 H 19"
                                          Stroke="#0F0F0F"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="QuickRecordLabel"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="#0F0F0F"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <Border x:Name="ShortcutBadge"
                                Grid.Column="1"
                                CornerRadius="5"
                                Background="#1F0F0F0F"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+Shift+O"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#CC0F0F0F" />
                        </Border>
                    </Grid>
                </Button>

                <!-- 4. Open App Row -->
                <Button Style="{StaticResource TrayRowButtonStyle}" Click="OpenApp_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 3,10 L 12,3 L 21,10 V 20 A 1,1 0 0 1 20,21 H 4 A 1,1 0 0 1 3,20 Z M 9,21 V 13 H 15 V 21"
                                      Stroke="{DynamicResource ForegroundSecondaryBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="OpenAppLabel"
                                   FontSize="13.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- 5. Sync Now Row -->
                <Button Style="{StaticResource TrayRowButtonStyle}" Click="SyncNow_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 21,12 A 9,9 0 1 1 18.36,5.64 M 21,3 V 9 H 15"
                                      Stroke="{DynamicResource ForegroundSecondaryBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="SyncNowLabel"
                                   FontSize="13.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- 6. Hairline Divider -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,6" />

                <!-- 7. Quit Row -->
                <Button Style="{StaticResource TrayDangerRowButtonStyle}" Click="ExitApp_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="ExitIcon"
                                      Data="M 12,2 V 12 M 18.36,6.64 A 9,9 0 1 1 5.64,6.64"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource SemanticDangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="ExitAppLabel"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SemanticDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
