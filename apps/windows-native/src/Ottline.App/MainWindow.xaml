<Window x:Class="Ottline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Ottline.App.Controls"
        mc:Ignorable="d"
        Title=""
        Icon="pack://application:,,,/Ottline.App;component/Resources/Icons/brand_mark.png"
        Width="1360"
        Height="880"
        MinWidth="800"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{StaticResource OttlineFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== DESKTOP HEADER (AppHeader.tsx + AppShell.module.css: seamlessly integrated with DWM title bar) ==================== -->
        <Grid Grid.Row="0"
              Background="{DynamicResource BackgroundBrush}"
              MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
            <Border MaxWidth="1280"
                    MinHeight="72"
                    Margin="24,0"
                    Padding="0,2,0,18"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Brand (.brand): 40x40 vector mark (mark.svg #1E4D8C in light / mark-inverse.svg #F8F6F2 in dark) + 8px gap + ottline (30px) + On the Timeline (9px) -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonUp="BrandHeader_Click">
                        <Viewbox Width="40"
                                 Height="40"
                                 Stretch="Uniform"
                                 Margin="0,0,8,0">
                            <Canvas Width="96" Height="96">
                                <Path Stroke="{DynamicResource BrandMarkBrush}"
                                      StrokeThickness="8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 14,34 V 28 C 14,22.477 18.477,18 24,18 C 34,18 41.5,21.8 48,27 C 55.8,21.8 65.5,18 77,18 C 82.523,18 87,22.477 87,28 V 64 C 87,69.523 82.523,74 77,74 C 66.5,74 57.2,76.9 51.5,81 M 15,49 L 36.5,62.75 L 15,76.5 Z" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ottline"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,-5,0,0" />
                            <TextBlock Text="ON THE TIMELINE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="1,-1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center-Right Top Navigation (.topNav: margin-left auto, gap 20px, icon 18px + 7px gap + 14px text, centered 18x2 #FF9933 active bar) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <!-- 홈 (Home) -->
                        <Button Click="NavHome_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                Margin="0,0,20,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid MinHeight="48" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="NavIcon"
                                                  Width="18"
                                                  Height="18"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource ForegroundMutedBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Margin="0,0,7,0"
                                                  Data="M 3,10 L 12,3 L 21,10 V 20 A 1,1 0 0 1 20,21 H 4 A 1,1 0 0 1 3,20 Z M 9,21 V 13 H 15 V 21" />
                                            <TextBlock x:Name="NavLabel"
                                                       Text="{Binding Strings.NavHome}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Height="2"
                                                Width="18"
                                                CornerRadius="1"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding IsHomeTab, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHomeTab}" Value="True">
                                            <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="NavLabel" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                                            <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 타임라인 (Clock) -->
                        <Button Click="NavTimeline_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                Margin="0,0,20,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid MinHeight="48" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="NavIcon"
                                                  Width="18"
                                                  Height="18"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource ForegroundMutedBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Margin="0,0,7,0"
                                                  Data="M 12,3 A 9,9 0 1 0 21,12 A 9,9 0 0 0 12,3 Z M 12,7 V 12 L 15.5,14" />
                                            <TextBlock x:Name="NavLabel"
                                                       Text="{Binding Strings.NavTimeline}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Height="2"
                                                Width="18"
                                                CornerRadius="1"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding IsTimelineTab, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTimelineTab}" Value="True">
                                            <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="NavLabel" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                                            <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 함께 (MessageCircle) -->
                        <Button Click="NavTogether_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                Margin="0,0,20,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid MinHeight="48" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="NavIcon"
                                                  Width="18"
                                                  Height="18"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource ForegroundMutedBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Margin="0,0,7,0"
                                                  Data="M 21,11.5 A 8.38,8.38 0 0 1 12.5,20 A 8.5,8.5 0 0 1 7.8,18.6 L 3,20 L 4.4,15.2 A 8.38,8.38 0 0 1 3,11.5 A 8.5,8.5 0 1 1 21,11.5 Z" />
                                            <TextBlock x:Name="NavLabel"
                                                       Text="{Binding Strings.NavTogether}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Height="2"
                                                Width="18"
                                                CornerRadius="1"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding IsTogetherTab, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTogetherTab}" Value="True">
                                            <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="NavLabel" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                                            <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 내 공간 (UserRound) -->
                        <Button Click="NavMySpace_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid MinHeight="48" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="NavIcon"
                                                  Width="18"
                                                  Height="18"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource ForegroundMutedBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Margin="0,0,7,0"
                                                  Data="M 12,4 A 4,4 0 1 0 16,8 A 4,4 0 0 0 12,4 Z M 4,20 C 4,16.5 7.5,14 12,14 C 16.5,14 20,16.5 20,20" />
                                            <TextBlock x:Name="NavLabel"
                                                       Text="{Binding Strings.NavMySpace}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Height="2"
                                                Width="18"
                                                CornerRadius="1"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding IsMySpaceTab, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMySpaceTab}" Value="True">
                                            <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="NavLabel" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                                            <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Right Actions (.actions: gap 8px — KO/EN + Theme Icon + '+ 기록 남기기' + ProfileAvatar) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- KO / EN Switcher (.langLink: min-width 32px, min-height 48px, font-size 10px, 100% hit-testable template) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button Click="SetLocaleKo_Click"
                                    MinWidth="34"
                                    MinHeight="48"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid MinWidth="34" MinHeight="48" Background="Transparent">
                                            <TextBlock x:Name="LangKoText"
                                                       Text="KO"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsKoreanLocale}" Value="True">
                                                <Setter TargetName="LangKoText" Property="TextDecorations" Value="Underline" />
                                                <Setter TargetName="LangKoText" Property="FontWeight" Value="Bold" />
                                                <Setter TargetName="LangKoText" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="LangKoText" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="SetLocaleEn_Click"
                                    MinWidth="34"
                                    MinHeight="48"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid MinWidth="34" MinHeight="48" Background="Transparent">
                                            <TextBlock x:Name="LangEnText"
                                                       Text="EN"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEnglishLocale}" Value="True">
                                                <Setter TargetName="LangEnText" Property="TextDecorations" Value="Underline" />
                                                <Setter TargetName="LangEnText" Property="FontWeight" Value="Bold" />
                                                <Setter TargetName="LangEnText" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="LangEnText" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Theme Toggle (.iconButton: min-width 40px, min-height 48px, borderless, 18px icon; cycles System -> Light -> Dark) -->
                        <Button Click="ToggleTheme_Click"
                                MinWidth="40"
                                MinHeight="48"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="{Binding ThemeToggleToolTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Path x:Name="ThemeIconPath"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource ForegroundMutedBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 8,12 A 4,4 0 1 1 16,12 A 4,4 0 1 1 8,12 Z M 12,2 V 4 M 12,20 V 22 M 4.93,4.93 L 6.34,6.34 M 17.66,17.66 L 19.07,19.07 M 2,12 H 4 M 20,12 H 22 M 6.34,17.66 L 4.93,19.07 M 19.07,4.93 L 17.66,6.34" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsThemeDark}" Value="True">
                                            <Setter TargetName="ThemeIconPath" Property="Data" Value="M 21,12.79 A 9,9 0 1 1 11.21,3 A 7,7 0 0 0 21,12.79 Z" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsThemeSystem}" Value="True">
                                            <Setter TargetName="ThemeIconPath" Property="Data" Value="M 4,3 H 20 A 2,2 0 0 1 22,5 V 15 A 2,2 0 0 1 20,17 H 4 A 2,2 0 0 1 2,15 V 5 A 2,2 0 0 1 4,3 Z M 8,21 H 16 M 12,17 V 21" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThemeIconPath" Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Primary Action Orange CTA (QuickLogAction.tsx: '+ 기록 남기기', min-height 48px, padding 10px 18px, radius 8px, #FF9933 bg, #0F0F0F text) -->
                        <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                Click="OpenQuickRecord_Click"
                                MinHeight="48"
                                Padding="18,10"
                                Margin="0,0,8,0"
                                ToolTip="{Binding Strings.HeaderQuickLogToolTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="+"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,-1,6,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Strings.HeaderQuickLogCta}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- .avatarLink: min-width 48px, min-height 48px wrapping 40x40 Circular ProfileAvatar -->
                        <Button Click="NavMySpace_Click"
                                MinWidth="48"
                                MinHeight="48"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4"
                                ToolTip="{Binding Strings.HeaderOpenMySpaceToolTip}">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="{DynamicResource CardElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <Image Source="{Binding CurrentAvatarImageUri}"
                                       Width="36"
                                       Height="36"
                                       Stretch="Uniform" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="1">

            <!-- =========================================================================
                 TAB 1: DESKTOP HOME VIEW (HomeTimelineView.tsx + app/[locale]/page.tsx)
                 Layout: .homeHeading + 3-Column .homeLayout (88px | 1fr | 215px) + .publicSection
                 ========================================================================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsHomeTab, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="1280" Margin="32,28,32,56">

                    <!-- Desktop OTT Watch Reminder Banner (>= 5 min foreground watch detected) -->
                    <Border Background="{DynamicResource CardElevatedBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="20,14"
                            Margin="0,0,0,18"
                            Visibility="{Binding HasActiveWatchBanner, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="WINDOWS DESKTOP OTT WATCH DETECTED"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="{Binding ActiveWatchBannerText}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                        Content="{Binding Strings.WatchBannerRecordNow}"
                                        Click="WatchBannerRecord_Click"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Content="{Binding Strings.CommonClose}"
                                        Click="WatchBannerDismiss_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- .homeHeading Row (HomeTimelineView.tsx: Eyebrow + H1 on Left | '+ 오늘의 기록 남기기' .recordButton on Right) -->
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Strings.HomeEyebrow}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding HomeDynamicHeadingTitle}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OpenQuickRecord_Click"
                                MinHeight="48"
                                Padding="18,12"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Visibility="{Binding HasLogs, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="+"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="0,-1,8,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Strings.HomeRecordTodayButton}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- .welcome Section + FirstLogActivationPanel (HomeTimelineView.tsx when !hasLogs) -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,24,0,0"
                            Visibility="{Binding IsHomeEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.HomeWelcomeSubtitle}"
                                       FontSize="17"
                                       LineHeight="27"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                        Content="{Binding Strings.HomeFirstRecordButton}"
                                        Click="OpenQuickRecord_Click"
                                        MinHeight="48"
                                        Padding="20,12"
                                        FontSize="16" />
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="8,12"
                                        Margin="14,0,0,0"
                                        Click="OpenMySpaceConnect_Click">
                                    <TextBlock Text="{Binding Strings.HomeBringExistingLink}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Store PWA / Browser Migration Handoff Banner -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    Margin="0,20,0,0"
                                    Padding="20,18"
                                    Visibility="{Binding ShowMigrationBanner, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Strings.HomeMigrationEyebrow}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="6,2"
                                                ToolTip="{Binding Strings.CommonClose}"
                                                Click="DismissMigrationBanner_Click">
                                            <TextBlock Text="✕"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding Strings.HomeMigrationTitle}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Strings.HomeMigrationBody}"
                                               FontSize="13.5"
                                               LineHeight="20"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <WrapPanel Margin="0,14,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                                Content="{Binding Strings.HomeMigrationEdgeButton}"
                                                Click="StartEdgeHandoff_Click"
                                                Margin="0,0,10,6" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.HomeMigrationBrowserButton}"
                                                Click="StartBrowserHandoff_Click"
                                                Margin="0,0,10,6" />
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="6,8"
                                                Click="OpenMySpaceConnect_Click"
                                                Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Strings.HomeMigrationCodeLink}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- FirstLogActivationPanel.tsx Card -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    Margin="0,24,0,0"
                                    Padding="24">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.ActivationEyebrow}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="{Binding Strings.ActivationTitle}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings.ActivationDescription}"
                                               FontSize="14"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               Margin="0,4,0,0" />

                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,18,0,0"
                                            Padding="0,18,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Strings.ActivationVideoTitle}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Text="{Binding Strings.ActivationVideoDescription}"
                                                               FontSize="13.5"
                                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        Click="OpenQuickRecord_Click">
                                                    <TextBlock Text="{Binding Strings.ActivationFindOtherVideo}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBrush}" />
                                                </Button>
                                            </Grid>

                                            <TextBlock Text="{Binding Strings.ActivationPopularSection}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       Margin="0,18,0,10" />

                                            <!-- 4-Column Popular Poster Grid -->
                                            <ItemsControl ItemsSource="{Binding HomePopularTitles}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Margin="0,0,12,12"
                                                                Padding="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Top"
                                                                Tag="{Binding}"
                                                                Click="ActivationPosterCard_Click">
                                                            <Border Background="{DynamicResource CardBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True"
                                                                    UseLayoutRounding="True"
                                                                    SnapsToDevicePixels="True">
                                                                <StackPanel>
                                                                    <!-- Exact 2:3 Aspect Ratio Poster Container (matches aspect-[2/3] w-full in FirstLogActivationPanel.tsx) -->
                                                                    <Viewbox Stretch="Uniform">
                                                                        <Grid Width="240"
                                                                              Height="360"
                                                                              Background="{DynamicResource BgSecondaryBrush}"
                                                                              ClipToBounds="True">
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontSize="14"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="16" />
                                                                            <Image Source="{Binding PosterUrl, Converter={StaticResource PosterConverter}}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </Grid>
                                                                    </Viewbox>
                                                                    <Border Padding="12,10"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="0,1,0,0">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontSize="13.5"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Year}"
                                                                                       FontSize="11.5"
                                                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                                       Margin="0,3,0,0" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- .homeLayout: 3-Column Desktop Grid (88px | 28px | * | 28px | 215px) -->
                    <Grid Visibility="{Binding HasLogs, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="215" />
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 1 (88px): .months Vertical Month Selector ("쌓아온 시간") -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Strings.HomeMonthsColumnTitle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding HomeMonthGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="SelectHomeMonth_Click"
                                                Tag="{Binding Key}"
                                                Cursor="Hand"
                                                Margin="0,0,0,8"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="MonthBtnBorder"
                                                            MinHeight="80"
                                                            CornerRadius="0,8,8,0"
                                                            Padding="12,12,8,12"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1,0,0,0">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding YearText}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                            <TextBlock x:Name="MonthBtnText"
                                                                       Text="{Binding MonthText}"
                                                                       FontSize="22"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="MonthBtnBorder" Property="Background" Value="{DynamicResource CardBrush}" />
                                                            <Setter TargetName="MonthBtnBorder" Property="BorderBrush" Value="{DynamicResource BrandNavyBrush}" />
                                                            <Setter TargetName="MonthBtnBorder" Property="BorderThickness" Value="2.5,0,0,0" />
                                                            <Setter TargetName="MonthBtnText" Property="Foreground" Value="{DynamicResource BrandNavyBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- COLUMN 2 (*): .homeMain (Featured Card + Month Entries + Moment Revisit) -->
                        <StackPanel Grid.Column="2">

                            <!-- 1) .featured Card ("그날의 온기", padding 24px 28px) -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    Padding="28,24"
                                    Visibility="{Binding HasFeaturedWarmth, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <!-- .featuredDate Header Row -->
                                    <Grid Margin="0,0,0,22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Strings.HomeFeaturedLabel}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FeaturedWarmthItem.DateShortLabel}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,16,0" />
                                        <Border Grid.Column="2"
                                                Height="1"
                                                Background="{DynamicResource BorderBrush}"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- .featuredBody 2-Column Grid (340x510 2:3 Poster | 26px Gap | * Story) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="340" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 2:3 Full-Column Poster Cover (.poster: 340x510, aspect-ratio 2/3, radius 8px) -->
                                        <Border Grid.Column="0"
                                                Width="340"
                                                Height="510"
                                                VerticalAlignment="Top"
                                                CornerRadius="8"
                                                ClipToBounds="True"
                                                Background="{DynamicResource CardElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="FeaturedWarmthCard_Click">
                                            <Grid>
                                                <Grid Margin="24">
                                                    <StackPanel VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding FeaturedWarmthItem.TypeAndYear}"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                                        <TextBlock Text="{Binding FeaturedWarmthItem.Log.Title.Title}"
                                                                   FontSize="26"
                                                                   FontWeight="Bold"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,18,0,0"
                                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                                        <TextBlock Text="{Binding FeaturedWarmthItem.CreatorLine}"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,10,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="ottline · ON THE TIMELINE"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Bottom" />
                                                </Grid>
                                                <Image Source="{Binding FeaturedWarmthItem.Log.Title.PosterUrl, Converter={StaticResource PosterConverter}, ConverterParameter=hero}"
                                                       Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <!-- .featuredStory Details (stretches vertically with bottom-aligned .featuredActions) -->
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <TextBlock Text="{Binding FeaturedWarmthItem.TypeAndYear}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                <TextBlock Text="{Binding FeaturedWarmthItem.Log.Title.Title}"
                                                           FontSize="28"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           Cursor="Hand"
                                                           MouseLeftButtonUp="FeaturedWarmthCard_Click" />
                                                <TextBlock Text="{Binding FeaturedWarmthItem.CreatorLine}"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                           Margin="0,6,0,0" />

                                                <TextBlock Text="{Binding FeaturedWarmthItem.StatusAndFeelingLine}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           Margin="0,12,0,0" />

                                                <TextBlock Text="{Binding FeaturedWarmthItem.EditionLine}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                           Margin="0,6,0,0" />

                                                <TextBlock Text="{Binding FeaturedWarmthItem.MomentSummary}"
                                                           FontSize="13.5"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>

                                            <!-- Note Blockquote (.featuredQuote) -->
                                            <Border Grid.Row="1"
                                                    VerticalAlignment="Top"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="2,0,0,0"
                                                    Padding="14,4,0,4"
                                                    Margin="0,18,0,18">
                                                <TextBlock Text="{Binding FeaturedWarmthItem.NotePreview}"
                                                           FontSize="17"
                                                           LineHeight="28"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource ForegroundBrush}" />
                                            </Border>

                                            <!-- Bottom Actions Row (.featuredActions: '이 기록 펼치기 →' on left, 48x48 Share Icon Button on right) -->
                                            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Padding="0,8"
                                                        Click="FeaturedWarmthDetail_Click">
                                                    <TextBlock Text="{Binding Strings.HomeFeaturedOpenAction}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBrush}" />
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Width="48"
                                                        Height="48"
                                                        Padding="0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip="{Binding Strings.HomeFeaturedShareToolTip}"
                                                        Click="FeaturedWarmthExportPng_Click">
                                                    <Path Width="17"
                                                          Height="17"
                                                          Stretch="Uniform"
                                                          Stroke="{DynamicResource ForegroundSecondaryBrush}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M 18,8 A 3,3 0 1 0 15,5 A 3,3 0 0 0 18,8 Z M 6,15 A 3,3 0 1 0 3,12 A 3,3 0 0 0 6,15 Z M 18,22 A 3,3 0 1 0 15,19 A 3,3 0 0 0 18,22 Z M 8.59,13.51 L 15.42,17.49 M 15.41,6.51 L 8.59,10.49" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2) .monthEntries ("이 달에 남긴 시간") -->
                            <StackPanel Margin="0,36,0,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedHomeMonthShort}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        <TextBlock Text="{Binding Strings.HomeMonthEntriesHeading}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            VerticalAlignment="Bottom"
                                            Click="NavTimeline_Click">
                                        <TextBlock Text="{Binding Strings.HomeTimelineLink}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                    </Button>
                                </Grid>

                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <ItemsControl ItemsSource="{Binding HomeMonthCompletedItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,14"
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="WatchLogCard_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="24" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding DateShortLabel}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   VerticalAlignment="Center" />

                                                        <!-- 44x66 Compact Poster -->
                                                        <Border Grid.Column="2"
                                                                Width="44"
                                                                Height="66"
                                                                CornerRadius="6"
                                                                ClipToBounds="True"
                                                                Background="{DynamicResource CardElevatedBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <TextBlock Text="{Binding TypeBadge}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <Image Source="{Binding Log.Title.PosterUrl, Converter={StaticResource PosterConverter}}"
                                                                       Stretch="UniformToFill"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Log.Title.Title}"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding StatusAndFeelingLine}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                                       Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding MomentSummary}"
                                                                       FontSize="12.5"
                                                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="5"
                                                                   Text="→"
                                                                   FontSize="15"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- 3) .momentRevisit ("다시 만나는 그날 · 어떤 순간을 펼쳐볼까요?") -->
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,40,0,0"
                                    Padding="0,28,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.HomeMomentRevisitEyebrow}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                                    <TextBlock Text="{Binding Strings.HomeMomentRevisitTitle}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings.HomeMomentRevisitSubtitle}"
                                               FontSize="14"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               Margin="0,6,0,16" />

                                    <!-- 2-Column Desktop Grid of Moment Cards -->
                                    <ItemsControl ItemsSource="{Binding HomeMomentLinks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="HomeMomentCard_Click"
                                                        Tag="{Binding}"
                                                        Cursor="Hand"
                                                        Margin="0,0,12,12"
                                                        Padding="16,14"
                                                        HorizontalContentAlignment="Stretch"
                                                        Style="{StaticResource SecondaryButtonStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Icon}"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Label}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding CountText}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,8,0" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="→"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- COLUMN 3 (215px): .homeSide ("아직 못다 한 이야기" + Side Links + Quiet Note) -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{Binding Strings.HomeUnfinishedHeading}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       Margin="0,0,0,10" />

                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0">
                                <ItemsControl ItemsSource="{Binding HomeUnfinishedItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,14"
                                                    Background="Transparent"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="WatchLogCard_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 54x81 Poster -->
                                                    <Border Grid.Column="0"
                                                            Width="54"
                                                            Height="81"
                                                            CornerRadius="6"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource CardElevatedBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="{Binding TypeBadge}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Image Source="{Binding Log.Title.PosterUrl, Converter={StaticResource PosterConverter}}"
                                                                   Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusBadge}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                                        <TextBlock Text="{Binding Log.Title.Title}"
                                                                   FontSize="14.5"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding EditionLine}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   Margin="0,2,0,0" />
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0,4,0,0"
                                                                HorizontalAlignment="Left"
                                                                Cursor="Hand"
                                                                Tag="{Binding Log}"
                                                                Click="PolishLogButton_Click">
                                                            <TextBlock Text="{Binding DataContext.Strings.HomeContinueLoggingLink, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Side Links: 쌓아온 시간 돌아보기 -> / 내 서가 펼치기 -> -->
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,18,0,0"
                                    Padding="0,12">
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        Padding="0"
                                        Click="OpenReportShortcut_Click">
                                    <TextBlock Text="{Binding Strings.HomeSideReportLink}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Button>
                            </Border>

                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,1"
                                    Padding="0,12">
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        Padding="0"
                                        Click="OpenBookshelfShortcut_Click">
                                    <TextBlock Text="{Binding Strings.HomeSideBookshelfLink}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Button>
                            </Border>

                            <TextBlock Text="{Binding Strings.HomeQuietNote}"
                                       FontSize="12.5"
                                       LineHeight="20"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Public Section on Home (app/[locale]/page.tsx .publicSection) -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,52,0,0"
                            Padding="0,32,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.HomePublicEyebrow}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                                    <TextBlock Text="{Binding Strings.HomePublicTitle}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Bottom"
                                        Click="NavTogether_Click">
                                    <TextBlock Text="{Binding Strings.HomePublicViewAllLink}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- 2-Column Desktop Grid (DiscussionList.tsx: rounded-2xl border bg-card p-4 -> grid-cols-2 -> 48x64 poster + title) -->
                            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                                <ItemsControl ItemsSource="{Binding HomeDiscussionsPreview}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="8"
                                                    Margin="4"
                                                    HorizontalContentAlignment="Stretch"
                                                    Tag="{Binding}"
                                                    Click="OpenDiscussionDetail_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 48x64 Poster Thumbnail -->
                                                    <Border Grid.Column="0"
                                                            Width="48"
                                                            Height="64"
                                                            CornerRadius="8"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource CardElevatedBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <Image Source="{Binding Title.PosterUrl, Converter={StaticResource PosterConverter}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>

                                                    <!-- Title + Body Preview -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title.Title}"
                                                                   FontSize="14.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Body}"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <!-- Right Metadata -->
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Author.DisplayName}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding DataContext.Strings.HomePublicItemAction, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Shared Desktop Footer (AppFooter.tsx 5 links) -->
                    <controls:OttlineFooterControl />
                </StackPanel>
            </ScrollViewer>

            <!-- =========================================================================
                 TAB 2: DESKTOP TIMELINE VIEW (app/[locale]/timeline/page.tsx + FiltersBar.tsx + LogCard.tsx)
                 Layout: .pageHeading + .timelineShortcuts + 5-Column Desktop Filter Grid + Month-Grouped 3-Col Rows
                 ========================================================================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsTimelineTab, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="1280" Margin="32,28,32,56">

                    <!-- .pageHeading Row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.TimelineEyebrow}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                            <TextBlock Text="{Binding TimelineHeadingTitle}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Strings.TimelinePageSubtitle}"
                                       FontSize="14.5"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                     Content="{Binding FutureButtonLabel}"
                                     Click="ToggleRecommendations_Click"
                                     Margin="0,0,10,0" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                     Content="{Binding Strings.TimelineExportCsvAction}"
                                     Click="ExportTimelineCsv_Click"
                                     ToolTip="{Binding Strings.ExportCsvButton}" />
                        </StackPanel>
                    </Grid>

                    <!-- .timelineShortcuts Row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0,4"
                                Margin="0,0,24,0"
                                Click="OpenReportShortcut_Click">
                            <TextBlock Text="{Binding Strings.TimelineShortcutReport}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </Button>
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0,4"
                                Click="OpenBookshelfShortcut_Click">
                            <TextBlock Text="{Binding Strings.TimelineShortcutBookshelf}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- Expandable '내 미래는?' Curated Recommendations Panel -->
                    <Border Background="{DynamicResource CardElevatedBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="22,18"
                            Margin="0,0,0,24"
                            Visibility="{Binding IsRecommendationsOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="WHAT'S NEXT ON YOUR TIMELINE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="{Binding Strings.TimelineRecsTitle}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding RecommendationQuotaText}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasRecommendationQuotaText, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding RecommendationActionButtonLabel}"
                                        IsEnabled="{Binding CanClickRecommendationAction}"
                                        VerticalAlignment="Top"
                                        Click="RefreshRecommendations_Click" />
                            </Grid>

                            <!-- Progress notice (keeps existing recommendation cards visible below) -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding IsRecommendationsLoading, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RecommendationLoadingMessage}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Gentle error notice + Retry (preserves existing cards below) -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource AccentOrangeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding HasRecommendationError, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RecommendationErrorMessage}"
                                               FontSize="13"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Strings.TimelineRecsRetryButton}"
                                            Visibility="{Binding CanRetryRecommendations, Converter={StaticResource BoolToVis}}"
                                            Click="RetryRecommendations_Click" />
                                </Grid>
                            </Border>

                            <!-- Ineligible (< 5 records) notice -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding IsRecommendationsIneligible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Strings.TimelineRecsNeedMoreLogs}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Empty filtered state -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding IsRecommendationsEmptyFiltered, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Strings.TimelineRecsEmptyFiltered}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding Recommendations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}"
                                                Margin="0,0,12,12"
                                                Padding="16">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="52"
                                                            Height="76"
                                                            CornerRadius="6"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource CardElevatedBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <Image Source="{Binding Title.PosterUrl, Converter={StaticResource PosterConverter}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title.Title}"
                                                                   FontSize="15.5"
                                                                   FontWeight="Bold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding MetaLine}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding ReasonDisplay}"
                                                           FontSize="12.5"
                                                           LineHeight="19"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,12" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                                            Content="{Binding ActionLabel}"
                                                            Padding="12,6"
                                                            Tag="{Binding Title}"
                                                            Click="RecommendationLog_Click"
                                                            Margin="0,0,8,0" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="{Binding ExcludeLabel}"
                                                            Padding="8,6"
                                                            Tag="{Binding}"
                                                            Click="RecommendationExclude_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- DESKTOP FILTER BAR (FiltersBar.tsx: Top underline tabs + 320px search + 5-Column Grid) -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="0,14,0,18"
                            Margin="0,0,0,28">
                        <StackPanel>
                            <!-- .filterTop Row -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Content Scope Tabs (전체 / 영상 / 책) -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="FilterTimelineAll_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="4,8"
                                            Margin="0,0,20,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Strings.FilterAll}" FontSize="15" FontWeight="SemiBold" />
                                            <Border Height="2"
                                                    Background="{DynamicResource BrandNavyBrush}"
                                                    Margin="0,6,0,0"
                                                    Visibility="{Binding IsTimelineFilterAll, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="FilterTimelineVideo_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="4,8"
                                            Margin="0,0,20,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Strings.FilterVideo}" FontSize="15" FontWeight="SemiBold" />
                                            <Border Height="2"
                                                    Background="{DynamicResource BrandNavyBrush}"
                                                    Margin="0,6,0,0"
                                                    Visibility="{Binding IsTimelineFilterVideo, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="FilterTimelineBook_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="4,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Strings.FilterBook}" FontSize="15" FontWeight="SemiBold" />
                                            <Border Height="2"
                                                    Background="{DynamicResource BrandNavyBrush}"
                                                    Margin="0,6,0,0"
                                                    Visibility="{Binding IsTimelineFilterBook, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ActiveTimelineFilterSummary}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,16,0" />

                                <!-- 320px Search Box -->
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource OttlineTextBoxStyle}"
                                             Text="{Binding TimelineSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Strings.TimelineFilterSearchHint}"
                                               FontSize="13"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TimelineSearchQuery}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="3"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="{Binding Strings.ClearFiltersButton}"
                                        Click="ClearTimelineFilters_Click"
                                        Margin="10,0,0,0" />
                            </Grid>

                            <!-- .filterFields: 5-Column Desktop Filter Grid (Always visible on desktop!) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Col 1: 상태 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Strings.TimelineFilterStatusLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Margin="0,0,0,6" />
                                    <ComboBox SelectedIndex="{Binding TimelineStatusComboIndex}" Padding="10,7">
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterStatusAll}" />
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterStatusDone}" />
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterStatusInProgress}" />
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterStatusWishlist}" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Col 2: 플랫폼 -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Strings.TimelineFilterPlatformLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding TimelinePlatformComboOptions}"
                                              SelectedIndex="{Binding TimelinePlatformComboIndex}"
                                              Padding="10,7" />
                                </StackPanel>

                                <!-- Col 3: 어디서 -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{Binding Strings.TimelineFilterPlaceLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding TimelinePlaceComboOptions}"
                                              SelectedIndex="{Binding TimelinePlaceComboIndex}"
                                              Padding="10,7" />
                                </StackPanel>

                                <!-- Col 4: 누구와·어떤 상황 -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="{Binding Strings.TimelineFilterOccasionLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding TimelineOccasionComboOptions}"
                                              SelectedIndex="{Binding TimelineOccasionComboIndex}"
                                              Padding="10,7" />
                                </StackPanel>

                                <!-- Col 5: 분류·온기 -->
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="{Binding Strings.TimelineFilterOriginLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Margin="0,0,0,6" />
                                    <ComboBox SelectedIndex="{Binding TimelineOriginComboIndex}" Padding="10,7">
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterOriginAll}" />
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterOriginSatisfied}" />
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterOriginNeutral}" />
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterOriginDisappointed}" />
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterOriginLog}" />
                                        <ComboBoxItem Content="{Binding Strings.TimelineFilterOriginReaction}" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- .emptyTimeline State (app/[locale]/timeline/page.tsx when 0 records match) -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="0,36"
                            Visibility="{Binding IsTimelineEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.TimelineEmptyTitle}"
                                       FontSize="15.5"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Padding="0,12,0,0"
                                    Click="OpenQuickRecord_Click">
                                <TextBlock Text="{Binding Strings.TimelineEmptyAction}"
                                           FontSize="14.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- .timelineList: Month-Grouped Editorial Rows (LogCard.tsx: 48px | 84px | 1fr) -->
                    <ItemsControl ItemsSource="{Binding TimelineMonthGroups}"
                                  Visibility="{Binding HasTimelineItems, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,36">
                                    <!-- .timelineMonth Header -->
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding MonthLabel}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}" />
                                            <TextBlock Text="{Binding DataContext.Strings.TimelineMonthSortCaption, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="12,0,0,3" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Month's .recordRow Items -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,22"
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="WatchLogCard_Click">
                                                    <!-- 3-Column Desktop Editorial Row: 48px Date | 24px | 84px Poster | 24px | * Content -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="84" />
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Col 1 (48px): .recordDate (Month short + 25px Day number) -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding MonthShortLabel}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                            <TextBlock Text="{Binding DayNumberText}"
                                                                       FontSize="25"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <!-- Col 2 (84px): 84x126 2:3 Poster -->
                                                        <Border Grid.Column="2"
                                                                Width="84"
                                                                Height="126"
                                                                VerticalAlignment="Top"
                                                                CornerRadius="6"
                                                                ClipToBounds="True"
                                                                Background="{DynamicResource CardElevatedBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <StackPanel VerticalAlignment="Center" Margin="8">
                                                                    <TextBlock Text="{Binding TypeBadge}"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource PrimaryBrush}" />
                                                                    <TextBlock Text="{Binding Log.Title.Title}"
                                                                               FontSize="11.5"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap"
                                                                               MaxHeight="68"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,6,0,0" />
                                                                </StackPanel>
                                                                <Image Source="{Binding Log.Title.PosterUrl, Converter={StaticResource PosterConverter}}"
                                                                       Stretch="UniformToFill"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- Col 3 (*): .recordContent -->
                                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MetaLine}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                            <TextBlock Text="{Binding Log.Title.Title}"
                                                                       FontSize="20"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                       Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding StatusAndFeelingLine}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                                       Margin="0,5,0,0" />
                                                            <TextBlock Text="{Binding MomentSummary}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                       Margin="0,4,0,0" />
                                                            <TextBlock Text="{Binding NotePreview}"
                                                                       FontSize="16"
                                                                       LineHeight="25"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                       Margin="0,8,0,0"
                                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />

                                                            <!-- .recordActions Row -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                                <Button Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Padding="0,4"
                                                                        Margin="0,0,18,0"
                                                                        Tag="{Binding Log}"
                                                                        Click="OpenLogDetailButton_Click">
                                                                    <TextBlock Text="{Binding DataContext.Strings.TimelineRowOpenAction, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource PrimaryBrush}" />
                                                                </Button>
                                                                <Button Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Padding="0,4"
                                                                        Margin="0,0,18,0"
                                                                        Tag="{Binding Log}"
                                                                        Click="PolishLogButton_Click">
                                                                    <TextBlock Text="{Binding DataContext.Strings.TimelineRowPolishAction, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                               FontSize="13"
                                                                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                                                </Button>
                                                                <Button Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Padding="0,4"
                                                                        Margin="0,0,18,0"
                                                                        Tag="{Binding Log}"
                                                                        Click="TimelineShareCard_Click">
                                                                    <TextBlock Text="{Binding DataContext.Strings.TimelineRowShareCardAction, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                               FontSize="13"
                                                                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                                                </Button>
                                                                <Button Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Padding="0,4"
                                                                        Margin="0,0,18,0"
                                                                        Tag="{Binding Log}"
                                                                        Click="TimelineShareTogether_Click">
                                                                    <TextBlock Text="{Binding DataContext.Strings.TimelineRowShareTogetherAction, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                               FontSize="13"
                                                                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                                                </Button>
                                                                <TextBlock Text="{Binding RevisionBadge}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Shared Desktop Footer -->
                    <controls:OttlineFooterControl />
                </StackPanel>
            </ScrollViewer>

            <!-- =========================================================================
                 TAB 3: TOGETHER 2-PANE SPLIT READER (Responsive: 2-pane >= 980px, single-pane < 980px)
                 ========================================================================= -->
            <Grid Visibility="{Binding IsTogetherTab, Converter={StaticResource BoolToVis}}">
                <Grid.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="8" />
                        <Setter Property="MinWidth" Value="8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent" Margin="2,2,0,2">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{DynamicResource BorderStrongBrush}"
                                                                    CornerRadius="4"
                                                                    Opacity="0.65" />
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Grid MaxWidth="1280"
                      Margin="32,24,32,20"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Together Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.TogetherEyebrow}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                            <TextBlock Text="{Binding Strings.TogetherHeadingTitle}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Strings.TogetherHeadingSubtitle}"
                                       FontSize="14"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Content="{Binding Strings.TogetherRefreshButton}"
                                    Margin="0,0,8,0"
                                    Click="RefreshTogether_Click" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding Strings.TogetherNewPostButton}"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    BorderBrush="{DynamicResource BrandNavyBrush}"
                                    Click="OpenWriteDiscussion_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Responsive Split Container -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding TogetherListColumnWidth}" />
                            <ColumnDefinition Width="{Binding TogetherGapColumnWidth}" />
                            <ColumnDefinition Width="{Binding TogetherDetailColumnWidth}" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT PANE: Search, Sort & Independently Scrollable List -->
                        <Grid Grid.Column="0"
                              Visibility="{Binding ShowTogetherListPane, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Search Input -->
                            <Grid Grid.Row="0">
                                <TextBox x:Name="TogetherSearchTextBox"
                                         Style="{StaticResource OttlineTextBoxStyle}"
                                         Padding="12,9,36,9"
                                         Text="{Binding TogetherSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding Strings.TogetherSearchPlaceholder}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="15,0,36,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTogetherSearchQuery}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Padding="8,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Foreground="{DynamicResource ForegroundMutedBrush}"
                                        Content="✕"
                                        Visibility="{Binding HasTogetherSearchQuery, Converter={StaticResource BoolToVis}}"
                                        Click="ClearTogetherSearch_Click" />
                            </Grid>

                            <!-- Sort Controls -->
                            <WrapPanel Grid.Row="1" Margin="0,10,0,12">
                                <Button Content="{Binding Strings.TogetherSortLatest}"
                                        Click="SortTogetherLatest_Click"
                                        Padding="12,6"
                                        Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTogetherSortLatest}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrandNavySoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandNavyBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{Binding Strings.TogetherSortReactions}"
                                        Click="SortTogetherReactions_Click"
                                        Padding="12,6"
                                        Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTogetherSortReactions}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrandNavySoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandNavyBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{Binding Strings.TogetherSortComments}"
                                        Click="SortTogetherComments_Click"
                                        Padding="12,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTogetherSortComments}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrandNavySoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandNavyBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <!-- List Area (Loading / Empty / Scrollable ListBox) -->
                            <Grid Grid.Row="2">
                                <Border Background="{DynamicResource CardElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="20,24"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding ShowTogetherListLoading, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Strings.TogetherListLoading}"
                                               FontSize="13.5"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Background="{DynamicResource CardElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="20,24"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding ShowTogetherEmptyState, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TogetherEmptyStateMessage}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.TogetherClearSearchButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,12,0,0"
                                                Visibility="{Binding HasTogetherSearchQuery, Converter={StaticResource BoolToVis}}"
                                                Click="ClearTogetherSearch_Click" />
                                    </StackPanel>
                                </Border>

                                <ListBox x:Name="TogetherDiscussionListBox"
                                         ItemsSource="{Binding DiscussionItems}"
                                         SelectedItem="{Binding SelectedDiscussionListItem, Mode=TwoWay}"
                                         SelectionMode="Single"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False"
                                         Visibility="{Binding HasTogetherDiscussions, Converter={StaticResource BoolToVis}}"
                                         PreviewKeyDown="TogetherList_PreviewKeyDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,6,10" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TogetherListItem_MouseUp" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="12,11">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource CardElevatedBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BrandNavyBrush}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="44"
                                                            Height="64"
                                                            VerticalAlignment="Top"
                                                            CornerRadius="6"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource BgSecondaryBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <Image Source="{Binding Title.PosterUrl, Converter={StaticResource PosterConverter}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title.Title}"
                                                                   FontSize="14.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding MetaLine}"
                                                                   FontSize="12"
                                                                   Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                            <Setter Property="FontWeight" Value="Medium" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ReactionSummaryText}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding HasReactions, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Snippet}"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0"
                                                                   Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>

                        <!-- RIGHT PANE: Independently Scrollable Selected Title & Comments Reader -->
                        <ScrollViewer x:Name="TogetherDetailScrollViewer"
                                      Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding ShowTogetherDetailPane, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,6,28">
                                <!-- Narrow-mode Back to List Bar -->
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Strings.TogetherBackToList}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,14"
                                        Visibility="{Binding ShowTogetherBackButton, Converter={StaticResource BoolToVis}}"
                                        Click="CloseNarrowTogetherDetail_Click" />

                                <!-- Empty Selection Placeholder (2-Pane only) -->
                                <Border Background="{DynamicResource CardElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="32,48"
                                        Visibility="{Binding ShowTogetherSelectPlaceholder, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Strings.TogetherSelectPromptTitle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings.TogetherSelectPromptBody}"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Active Selected Discussion Reader -->
                                <StackPanel Visibility="{Binding HasSelectedDiscussion, Converter={StaticResource BoolToVis}}">
                                    <!-- Title & Reactions Header Card -->
                                    <Border Style="{StaticResource CardBorderStyle}"
                                            Padding="22,20"
                                            Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="96"
                                                    Height="144"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="8"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource BgSecondaryBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Image Source="{Binding SelectedDiscussionPost.Title.PosterUrl, Converter={StaticResource PosterConverter}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding SelectedDiscussionTypeAndYear}"
                                                           FontSize="12.5"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                <TextBlock Text="{Binding SelectedDiscussionPost.Title.Title}"
                                                           FontSize="23"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,10" />
                                                <TextBlock Text="{Binding SelectedDiscussionBody}"
                                                           FontSize="14.5"
                                                           LineHeight="23"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,14"
                                                           Visibility="{Binding HasSelectedDiscussionBody, Converter={StaticResource BoolToVis}}" />

                                                <!-- Reaction Chips -->
                                                <WrapPanel Margin="0,0,0,14">
                                                    <Button Content="{Binding SelectedReactionDoneLabel}"
                                                            IsEnabled="{Binding CanToggleTogetherReaction}"
                                                            Padding="12,7"
                                                            Margin="0,0,8,8"
                                                            Click="ReactSelectedDone_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelectedReactionDone}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BrandNavySoftBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandNavyBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="{Binding SelectedReactionCuriousLabel}"
                                                            IsEnabled="{Binding CanToggleTogetherReaction}"
                                                            Padding="12,7"
                                                            Margin="0,0,8,8"
                                                            Click="ReactSelectedCurious_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelectedReactionCurious}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BrandNavySoftBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandNavyBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="{Binding SelectedReactionSaveLabel}"
                                                            IsEnabled="{Binding CanToggleTogetherReaction}"
                                                            Padding="12,7"
                                                            Margin="0,0,0,8"
                                                            Click="ReactSelectedSave_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelectedReactionSave}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BrandNavySoftBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandNavyBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </WrapPanel>

                                                <!-- Local Record Linkage Actions -->
                                                <WrapPanel>
                                                    <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                                            Content="{Binding Strings.TogetherLogThisTitle}"
                                                            Padding="16,9"
                                                            Margin="0,0,10,0"
                                                            Click="LogSelectedDiscussionTitle_Click" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="{Binding Strings.TogetherOpenMyRecord}"
                                                            Foreground="{DynamicResource PrimaryBrush}"
                                                            BorderBrush="{DynamicResource BrandNavyBrush}"
                                                            Padding="14,9"
                                                            Visibility="{Binding SelectedDiscussionHasLocalLog, Converter={StaticResource BoolToVis}}"
                                                            Click="OpenSelectedDiscussionRecord_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Comments Card -->
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="22,20">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Strings.TogetherCommentsHeading}"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <Border Background="{DynamicResource BgSecondaryBrush}"
                                                            CornerRadius="8"
                                                            Padding="8,2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedDiscussionCommentCountLabel}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Strings.TogetherCommentsLoading}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelectedDiscussionDetailLoading, Converter={StaticResource BoolToVis}}" />
                                            </Grid>

                                            <!-- Comment Composer -->
                                            <Border Background="{DynamicResource CardElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14"
                                                    Margin="0,0,0,16">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBox Style="{StaticResource OttlineTextBoxStyle}"
                                                                 Text="{Binding NewCommentBody, UpdateSourceTrigger=PropertyChanged}"
                                                                 KeyDown="CommentInput_KeyDown" />
                                                        <TextBlock Text="{Binding Strings.CommentPlaceholder}"
                                                                   FontSize="13.5"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   Margin="15,0,12,0"
                                                                   VerticalAlignment="Center"
                                                                   IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasNewCommentBody}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding NewCommentSyncLog}"
                                                                  Content="{Binding Strings.TogetherSyncLogCheckbox}"
                                                                  Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                  FontSize="12.5"
                                                                  VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource PrimaryActionButtonStyle}"
                                                                Content="{Binding Strings.DiscussionSendCommentBtn}"
                                                                IsEnabled="{Binding CanSubmitComment}"
                                                                Padding="16,8"
                                                                Click="SubmitComment_Click" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Error Notice -->
                                            <Border Background="{DynamicResource CardElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16,14"
                                                    Margin="0,0,0,12"
                                                    Visibility="{Binding HasSelectedDiscussionDetailError, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Strings.TogetherCommentsLoadError}"
                                                               FontSize="13.5"
                                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="{Binding Strings.TogetherCommentsRetry}"
                                                            Margin="12,0,0,0"
                                                            Click="RetryDiscussionDetail_Click" />
                                                </Grid>
                                            </Border>

                                            <!-- Empty Comments Notice -->
                                            <TextBlock Text="{Binding Strings.TogetherCommentsEmpty}"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       Margin="2,8,2,8"
                                                       Visibility="{Binding IsSelectedDiscussionCommentsEmpty, Converter={StaticResource BoolToVis}}" />

                                            <!-- Comments List -->
                                            <ItemsControl ItemsSource="{Binding SelectedDiscussionComments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="2,12">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Author.DisplayName}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding CreatedAt}"
                                                                               FontSize="11.5"
                                                                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Body}"
                                                                           FontSize="14.5"
                                                                           LineHeight="22"
                                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,5,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Shared Desktop Footer inside Together Reader -->
                                <controls:OttlineFooterControl />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- =========================================================================
                 TAB 4: DESKTOP MY SPACE VIEW (app/[locale]/account/page.tsx + AccountSpace.module.css)
                 Layout: .pageHeading + Sub-section pills + Top .profilePanel + 2-Col .grid + 2-Col .lowerGrid
                 ========================================================================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsMySpaceTab, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="1280" Margin="32,28,32,56">

                    <!-- .pageHeading -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{Binding Strings.MySpaceEyebrow}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                        <TextBlock Text="{Binding Strings.MySpaceHeadingTitle}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Strings.MySpaceHeadingSubtitle}"
                                   FontSize="14.5"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Desktop Sub-view Switcher Bar -->
                    <WrapPanel Margin="0,0,0,22">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding Strings.MySpaceTabProfileSync}"
                                Click="MySpaceProfile_Click"
                                Margin="0,0,8,8" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding Strings.MySpaceTabReport}"
                                Click="MySpaceReport_Click"
                                Margin="0,0,8,8" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding Strings.MySpaceTabBookshelf}"
                                Click="MySpaceBookshelf_Click"
                                Margin="0,0,8,8" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding Strings.MySpaceTabWatchReminder}"
                                Click="MySpaceWatchReminder_Click"
                                Margin="0,0,8,8" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding Strings.MySpaceTabFeedback}"
                                Click="MySpaceFeedback_Click"
                                Margin="0,0,8,8" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding Strings.MySpaceTabGuides}"
                                Click="MySpaceGuides_Click"
                                Margin="0,0,8,8" />
                    </WrapPanel>

                    <!-- 1) MAIN ACCOUNT DASHBOARD (Matches app/[locale]/account/page.tsx 1:1) -->
                    <StackPanel Visibility="{Binding IsMySpaceProfileSync, Converter={StaticResource BoolToVis}}">

                        <!-- Top .profilePanel: Horizontal Desktop Profile Card + Expandable ProfileEditor -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Padding="26,22"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="80"
                                            Height="80"
                                            CornerRadius="40"
                                            Background="{DynamicResource CardElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Image Source="{Binding CurrentAvatarImageUri}"
                                               Width="72"
                                               Height="72"
                                               Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings.MySpaceProfileLabel}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        <TextBlock Text="{Binding Settings.DisplayName}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding CurrentAvatarPersonaLabel}"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Strings.MySpaceProfilePrivacyHint}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Strings.MySpaceChoosePersonaButton}"
                                            VerticalAlignment="Center"
                                            Click="ToggleProfileEditor_Click" />
                                </Grid>

                                <!-- Expandable Inline ProfileEditor (6 Storybook Animal Personas) -->
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,20,0,0"
                                        Padding="0,20,0,0"
                                        Visibility="{Binding IsProfileEditorOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Strings.MySpaceAvatarPickerTitle}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding AvatarOptions}" Margin="0,0,0,16">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardElevatedBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10"
                                                            Margin="0,0,10,0"
                                                            Cursor="Hand"
                                                            Tag="{Binding Key}"
                                                            MouseLeftButtonUp="AvatarOption_Click">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <Image Source="{Binding ImageUri}" Width="48" Height="48" Stretch="Uniform" />
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="12.5"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,6,0,0" />
                                                            <TextBlock Text="{Binding Subtitle}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Style="{StaticResource OttlineTextBoxStyle}"
                                                     Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2"
                                                     Style="{StaticResource OttlineTextBoxStyle}"
                                                     Text="{Binding EditBio, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,12,0" />
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                                    Content="{Binding Strings.MySpaceSavePersonaButton}"
                                                    Click="SaveProfile_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Upper 2-Column Desktop Grid (.grid: 1fr | 20px | 1fr) -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Panel: 내 기록 이어보기 -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.MySpaceContinueTitle}" FontSize="19" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Strings.MySpaceContinueBody}"
                                               FontSize="13.5"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,16" />

                                    <Border Background="{DynamicResource BackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="18,14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Strings.MySpaceMyCodeLabel}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                                            <TextBlock Text="{Binding DisplayRecoveryCode}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.CopyCodeButton}"
                                                Click="CopyRecoveryCode_Click"
                                                Margin="0,0,10,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.MySpaceSaveRecoveryPngButton}"
                                                Click="ExportRecoveryCard_Click" />
                                    </StackPanel>

                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Strings.MySpaceOtherDeviceTitle}"
                                                       FontSize="16"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="{Binding Strings.MySpaceOtherDeviceBody}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,12" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Style="{StaticResource OttlineTextBoxStyle}"
                                                         Text="{Binding PairCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,10,0" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                                        Content="{Binding Strings.MySpaceReceiveLogsButton}"
                                                        Click="PreviewPair_Click" />
                                            </Grid>

                                            <Border Background="{DynamicResource CardElevatedBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14"
                                                    Margin="0,12,0,0"
                                                    Visibility="{Binding HasPairPreview, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Strings.MySpaceMergeReadyTitle}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Strings.MySpaceMergeReadyBody}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                               Margin="0,4,0,10" />
                                                    <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                                            Content="{Binding Strings.MySpaceConfirmMergeAction}"
                                                            Click="ConfirmPairMerge_Click" />
                                                </StackPanel>
                                            </Border>

                                            <WrapPanel Margin="0,14,0,0">
                                                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                                        Content="{Binding Strings.HomeMigrationEdgeButton}"
                                                        Click="StartEdgeHandoff_Click"
                                                        Margin="0,0,10,6" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="{Binding Strings.HomeMigrationBrowserButton}"
                                                        Click="StartBrowserHandoff_Click"
                                                        Margin="0,0,0,6" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Right Column (.sideStack): 연결된 기기 + 기록을 더 잘 이어가도록 -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="24" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Strings.MySpaceConnectedDevicesTitle}" FontSize="19" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Strings.MySpaceConnectedDevicesSubtitle}"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                   Margin="0,4,0,14" />
                                        <Border Background="{DynamicResource BackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Strings.MySpaceCurrentDeviceLabel}"
                                                               FontSize="14.5"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Settings.DeviceId}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SyncStatusText}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Strings.MySpaceExploreMoreTitle}" FontSize="19" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Strings.MySpaceExploreMoreSubtitle}"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                   Margin="0,4,0,14" />
                                        <WrapPanel>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding Strings.HomeSideReportLink}"
                                                    Click="MySpaceReport_Click"
                                                    Margin="0,0,10,10" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding Strings.HomeSideBookshelfLink}"
                                                    Click="MySpaceBookshelf_Click"
                                                    Margin="0,0,10,10" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding Strings.FooterFeedbackLink}"
                                                    Click="MySpaceFeedback_Click"
                                                    Margin="0,0,10,10" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding Strings.FooterGuidesLink}"
                                                    Click="OpenGuidesShortcut_Click"
                                                    Margin="0,0,10,10" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding Strings.FooterAboutLink}"
                                                    Click="OpenAboutShortcut_Click"
                                                    Margin="0,0,10,10" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding Strings.FooterFaqLink}"
                                                    Click="OpenFaqShortcut_Click"
                                                    Margin="0,0,10,10" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding Strings.FooterPrivacyLink}"
                                                    Click="OpenPrivacyShortcut_Click"
                                                    Margin="0,0,10,10" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Lower 2-Column Desktop Grid (.lowerGrid: CSV Export/Import | Data Management) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Panel: 기록 내보내기 · 가져오기 (CSV) -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.MySpaceCsvSectionTitle}" FontSize="19" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Strings.MySpaceCsvSectionBody}"
                                               FontSize="13.5"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,16" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                                Content="{Binding Strings.MySpaceDownloadCsvButton}"
                                                Click="ExportTimelineCsv_Click"
                                                Margin="0,0,10,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.MySpaceImportNetflixButton}"
                                                Click="ImportNetflixCsv_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right Panel: 기록과 연결 데이터 관리 -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.MySpaceDataManageTitle}" FontSize="19" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Strings.MySpaceDataManageBody}"
                                               FontSize="13.5"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,16" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.MySpaceResetLocalAction}"
                                                Click="LocalReset_Click"
                                                Margin="0,0,10,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding DeleteAccountButtonLabel}"
                                                IsEnabled="{Binding CanDeleteServerAccount}"
                                                Foreground="{DynamicResource ErrorBrush}"
                                                Click="ServerDeleteAccount_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 2) PERSONAL REPORT SUB-VIEW (쌓아온 시간 돌아보기) -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="28"
                            Visibility="{Binding IsMySpaceReport, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.ReportHeadingTitle}" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PersonalReportRhythmDisplay}"
                                               FontSize="14.5"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Content="{Binding Strings.ExportRecapCardButton}"
                                        Click="ExportRecapCard_Click" />
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,0,0,20">
                                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Strings.ReportTotalLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        <TextBlock Text="{Binding PersonalReport.TotalCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Strings.ReportVideoLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        <TextBlock Text="{Binding PersonalReport.VideoCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Strings.ReportBookLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        <TextBlock Text="{Binding PersonalReport.BookCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Strings.ReportSatisfiedLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        <TextBlock Text="{Binding PersonalReport.SatisfiedCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 3) KDC BOOKSHELF SUB-VIEW (내 서가 펼치기) -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="28"
                            Visibility="{Binding IsMySpaceBookshelf, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.BookshelfHeadingTitle}" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="{Binding Strings.BookshelfHeadingSubtitle}"
                                       FontSize="14"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       Margin="0,4,0,20" />
                            <ItemsControl ItemsSource="{Binding KdcShelves}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="18"
                                                Margin="0,0,14,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding LabelKo}" FontSize="16" FontWeight="Bold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Books.Count, StringFormat='{}{0}'}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 4) WINDOWS DESKTOP WATCH REMINDER & SHORTCUT SETTINGS -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="28"
                            Visibility="{Binding IsMySpaceWatchReminder, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.WatchPrefHeadingTitle}" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="{Binding Strings.WatchPrefHeadingSubtitle}"
                                       FontSize="14"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       Margin="0,4,0,20" />

                            <CheckBox x:Name="WatchReminderToggleBox"
                                      IsChecked="{Binding Settings.WatchReminderEnabled}"
                                      Click="DesktopPrefChanged_Click"
                                      Content="{Binding Strings.WatchPrefToggleWatch}"
                                      FontSize="14.5"
                                      Margin="0,0,0,12" />
                            <CheckBox x:Name="RevisitReminderToggleBox"
                                      IsChecked="{Binding Settings.RevisitReminderEnabled}"
                                      Click="DesktopPrefChanged_Click"
                                      Content="{Binding Strings.WatchPrefToggleRevisit}"
                                      FontSize="14.5"
                                      Margin="0,0,0,12" />
                            <CheckBox x:Name="GlobalHotkeyToggleBox"
                                      IsChecked="{Binding Settings.GlobalHotkeyEnabled}"
                                      Click="DesktopPrefChanged_Click"
                                      Content="{Binding Strings.WatchPrefToggleHotkey}"
                                      FontSize="14.5"
                                      Margin="0,0,0,12" />
                            <CheckBox x:Name="MinimizeToTrayToggleBox"
                                      IsChecked="{Binding Settings.MinimizeToTray}"
                                      Click="DesktopPrefChanged_Click"
                                      Content="{Binding Strings.WatchPrefToggleTray}"
                                      FontSize="14.5"
                                      Margin="0,0,0,20" />

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Strings.WatchPrefTestButton}"
                                        Click="TestWatchReminder_Click"
                                        Margin="0,0,12,0" />
                            </StackPanel>

                            <!-- Windows 11 Official Widget (Win + W) Live Preview -->
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,24,0,0"
                                    Padding="0,18,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Strings.WidgetSectionTitle}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource AccentOrangeSoftBrush}"
                                                CornerRadius="999"
                                                Padding="10,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WidgetStatusBadgeText}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrandNavyBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Strings.WidgetSectionSubtitle}"
                                               FontSize="13.5"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,14" />

                                    <TextBlock Text="{Binding Strings.WidgetPreviewLabel}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               Margin="0,0,0,8" />

                                    <Border Width="360"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource CardElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="ottline"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource BrandNavyBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WidgetPreviewSnapshot.MonthBadge}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                            </Grid>

                                            <Border Background="{DynamicResource BgCardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="WidgetPreviewHero_Click"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="48"
                                                            Height="68"
                                                            CornerRadius="6"
                                                            ClipToBounds="True"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            Margin="0,0,12,0"
                                                            Visibility="{Binding HasWidgetPoster, Converter={StaticResource BoolToVis}}">
                                                        <Image Source="{Binding WidgetPosterUrl, Converter={StaticResource PosterConverter}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding WidgetHeroEyebrow}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrandNavyBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding WidgetHeroTitle}"
                                                                   FontSize="14.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding WidgetHeroMeta}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding HasWidgetHeroMeta, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding WidgetHeroNote}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="34"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <WrapPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                                        Content="{Binding Strings.WidgetBtnQuickRecord}"
                                                        Click="WidgetPreviewQuickRecord_Click"
                                                        Padding="12,6"
                                                        FontSize="12.5"
                                                        Margin="0,0,6,0" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="{Binding Strings.WidgetBtnVideo}"
                                                        Click="WidgetPreviewVideo_Click"
                                                        Padding="10,6"
                                                        FontSize="12.5"
                                                        Margin="0,0,6,0" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="{Binding Strings.WidgetBtnBook}"
                                                        Click="WidgetPreviewBook_Click"
                                                        Padding="10,6"
                                                        FontSize="12.5"
                                                        Margin="0,0,6,0" />
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Content="{Binding Strings.WidgetBtnTimeline}"
                                                        Click="WidgetPreviewTimeline_Click"
                                                        Padding="10,6"
                                                        FontSize="12.5" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,24,0,0"
                                    Padding="0,18,0,0"
                                    Visibility="{Binding ShowDeveloperServerSettings, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.WatchPrefServerLabel}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ServerUrlTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource OttlineTextBoxStyle}"
                                                 Text="{Binding Settings.BaseUrl}"
                                                 Margin="0,0,10,0" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.WatchPrefApplyButton}"
                                                Click="ApplyCustomServerUrl_Click"
                                                Margin="0,0,8,0" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Content="Production (ottline.app)"
                                                Tag="https://ottline.app"
                                                Click="SwitchServerPreset_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 5) FEEDBACK SUB-VIEW (FeedbackInbox.tsx 1:1) -->
                    <StackPanel Visibility="{Binding IsMySpaceFeedback, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Strings.FeedbackHeadingTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Text="{Binding Strings.FeedbackHeadingSubtitle}"
                                   FontSize="14"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Margin="0,4,0,18" />

                        <!-- 새 문의 작성 카드 -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Padding="24"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{Binding Strings.FeedbackNewThreadTitle}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Strings.FeedbackCategoryLabel}"
                                                   FontSize="12.5"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding FeedbackCategoryComboOptions}"
                                                  SelectedIndex="{Binding FeedbackCategoryComboIndex}"
                                                  Padding="10,9" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Strings.FeedbackSubjectLabel}"
                                                   FontSize="12.5"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,6" />
                                        <Grid>
                                            <TextBox Style="{StaticResource OttlineTextBoxStyle}"
                                                     Text="{Binding NewFeedbackSubject, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding Strings.FeedbackSubjectPlaceholder}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,0,0"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewFeedbackSubject}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding Strings.FeedbackBodyLabel}"
                                           FontSize="12.5"
                                           FontWeight="Medium"
                                           Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,14">
                                    <TextBox Style="{StaticResource OttlineTextBoxStyle}"
                                             Text="{Binding NewFeedbackBody, UpdateSourceTrigger=PropertyChanged}"
                                             Height="132"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True" />
                                    <TextBlock Text="{Binding Strings.FeedbackBodyPlaceholder}"
                                               FontSize="13"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Top"
                                               Margin="14,12,14,0"
                                               TextWrapping="Wrap"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NewFeedbackBody}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Strings.FeedbackCreateNotice}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource PrimaryActionButtonStyle}"
                                            Content="{Binding Strings.FeedbackSubmitAction}"
                                            Padding="22,12"
                                            Click="SubmitFeedback_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 내 문의 목록 + 대화 상세 2-Column Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: 내 문의 목록 -->
                            <Border Grid.Column="0"
                                    Style="{StaticResource CardBorderStyle}"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.FeedbackMyThreadsTitle}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />

                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="18"
                                            Visibility="{Binding IsFeedbackThreadsEmpty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Strings.FeedbackEmptyThreads}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding FeedbackThreads}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="{DynamicResource CardElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Padding="14,12"
                                                        Margin="0,0,0,10"
                                                        HorizontalContentAlignment="Stretch"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="SelectFeedbackThread_Click">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding CategoryDisplay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding StatusDisplay}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Subject}"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding LastMessagePreview}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding UpdatedAtDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                   Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Right: 선택된 문의 대화 내역 -->
                            <Border Grid.Column="2"
                                    Style="{StaticResource CardBorderStyle}"
                                    Padding="22">
                                <Grid>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="28"
                                            Visibility="{Binding IsSelectedFeedbackThreadEmpty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Strings.FeedbackEmptyDetail}"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Visibility="{Binding HasSelectedFeedbackThread, Converter={StaticResource BoolToVis}}">
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,0,0,14"
                                                Margin="0,0,0,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource CardElevatedBrush}"
                                                            CornerRadius="10"
                                                            Padding="8,3"
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SelectedFeedbackThread.CategoryDisplay}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedFeedbackThread.StatusDisplay}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedFeedbackThread.Subject}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Margin="0,6,0,4" />
                                                <TextBlock Text="{Binding SelectedFeedbackThread.UpdatedAtDisplay}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding SelectedFeedbackThread.Messages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardElevatedBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="16,12"
                                                            Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding RoleDisplay}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryBrush}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding CreatedAt}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Body}"
                                                                       FontSize="13.5"
                                                                       LineHeight="22"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 6) GUIDES SUB-VIEW (기록 가이드) -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="28"
                            Visibility="{Binding IsMySpaceGuides, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.GuidesHeadingTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="{Binding Strings.GuidesBodyText}"
                                       FontSize="15"
                                       LineHeight="26"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,16" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding AboutPage.BrowseAllGuidesLabel}"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    BorderBrush="{DynamicResource BrandNavyBrush}"
                                    HorizontalAlignment="Left"
                                    Click="OpenGuidesShortcut_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Shared Desktop Footer -->
                    <controls:OttlineFooterControl />
                </StackPanel>
            </ScrollViewer>

            <!-- =========================================================================
                 TAB 5: SHARED INFO PAGES (Guides, About, FAQ, Privacy — Web/macOS parity)
                 ========================================================================= -->
            <controls:OttlineInfoPagesView Visibility="{Binding IsInfoTab, Converter={StaticResource BoolToVis}}" />

            <!-- =========================================================================
                 MODAL OVERLAY 1: DESKTOP TITLE DETAIL (app/[locale]/title/[id]/page.tsx)
                 Layout: 2-Column Hero (240x360 Poster | * Story + 4-Col TPO Grid + History)
                 ========================================================================= -->
            <Border Background="{DynamicResource OverlayScrimBrush}"
                    Visibility="{Binding IsTitleDetailOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource CardBorderStyle}"
                        MaxWidth="1040"
                        MaxHeight="800"
                        Margin="40"
                        Padding="32,28"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Padding="0,4"
                                    Margin="0,0,0,18"
                                    Click="CloseTitleDetail_Click">
                                <TextBlock Text="{Binding Strings.DetailBackToTimeline}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Button>

                            <!-- 2-Column Desktop Hero (.detailHero) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 240x360 Poster -->
                                <Border Grid.Column="0"
                                        Width="240"
                                        Height="360"
                                        VerticalAlignment="Top"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{DynamicResource CardElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="20">
                                            <TextBlock Text="{Binding SelectedDetailMetaLine}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedDetailLog.Title.Title}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,12,0,0" />
                                        </StackPanel>
                                        <Image Source="{Binding SelectedDetailLog.Title.PosterUrl, Converter={StaticResource PosterConverter}}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>

                                <!-- Right Story Details -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding SelectedDetailMetaLine}"
                                               FontSize="13"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedDetailLog.Title.Title}"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,8" />
                                    <TextBlock Text="{Binding SelectedDetailFeelingBadge}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,0,18" />

                                    <!-- 4-Column Desktop TPO Definition Grid (언제 / 플랫폼 / 어디서 / 누구와·어떤 상황) -->
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,1"
                                            Padding="0,14"
                                            Margin="0,0,0,20">
                                        <UniformGrid Columns="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Strings.DetailWhenLabel}" FontSize="11.5" Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                <TextBlock Text="{Binding SelectedDetailWhenText}" FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Strings.TimelineFilterPlatformLabel}" FontSize="11.5" Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                <TextBlock Text="{Binding SelectedDetailPlatformText}" FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Strings.TimelineFilterPlaceLabel}" FontSize="11.5" Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                <TextBlock Text="{Binding SelectedDetailPlaceText}" FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Strings.TimelineFilterOccasionLabel}" FontSize="11.5" Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                <TextBlock Text="{Binding SelectedDetailOccasionText}" FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <!-- Note Blockquote -->
                                    <Border BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="3,0,0,0"
                                            Padding="16,6,0,6"
                                            Margin="0,0,0,20">
                                        <TextBlock Text="{Binding SelectedDetailNoteText}"
                                                   FontSize="16.5"
                                                   LineHeight="26"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                        <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                                Content="{Binding Strings.DetailPolishAction}"
                                                Click="PolishFromDetail_Click"
                                                Margin="0,0,10,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.DetailShareCardAction}"
                                                Click="ExportDetailShareCard_Click"
                                                Margin="0,0,10,0" />
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Content="{Binding Strings.DetailToggleSpoilerAction}"
                                                Click="ToggleDetailSpoiler_Click" />
                                    </StackPanel>

                                    <!-- 남겨온 기록 (Revision History - 낙장불입) -->
                                    <TextBlock Text="{Binding Strings.DetailHistoryHeading}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding SelectedTitleHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RecordedAt}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                                                        <TextBlock Text="{Binding Note}"
                                                                   FontSize="14"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- =========================================================================
                 MODAL OVERLAY 2: QUICK RECORD MODAL (+ 오늘의 기록 남기기 / Ctrl+K)
                 ========================================================================= -->
            <Border Background="{DynamicResource OverlayScrimBrush}"
                    Visibility="{Binding IsQuickRecordOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource CardBorderStyle}"
                        Width="910"
                        MaxHeight="800"
                        Padding="28,24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.QuickModalEyebrow}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="{Binding Strings.QuickModalHeading}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="{Binding Strings.CommonCloseWithX}"
                                        Click="CloseQuickRecord_Click" />
                            </Grid>

                            <!-- STAGE 1: SEARCH -->
                            <StackPanel Visibility="{Binding IsQuickSearchStage, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Strings.FilterAll}" Click="QuickFilterAll_Click" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Strings.QuickFilterVideoLabel}" Click="QuickFilterVideo_Click" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Strings.QuickFilterBookLabel}" Click="QuickFilterBook_Click" />
                                </StackPanel>

                                <TextBox x:Name="QuickSearchTextBox"
                                         Style="{StaticResource OttlineTextBoxStyle}"
                                         Text="{Binding QuickSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10" />

                                <TextBlock Text="{Binding Strings.QuickSuggestionsHeader}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="2,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuickSearchQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding QuickSearchResults}" MaxHeight="340">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="10,12"
                                                    Background="Transparent"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="SelectQuickSearchResult_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="42"
                                                            Height="63"
                                                            CornerRadius="6"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource CardElevatedBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <Image Source="{Binding PosterUrl, Converter={StaticResource PosterConverter}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding OriginalTitle}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding DataContext.Strings.QuickSelectAction, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{DynamicResource BackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource OttlineTextBoxStyle}"
                                                 Text="{Binding ManualTitleInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.QuickManualAddVideo}"
                                                Click="CreateManualVideo_Click"
                                                Margin="0,0,8,0" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding Strings.QuickManualAddBook}"
                                                Click="CreateManualBook_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- STAGE 2: FORM -->
                            <StackPanel Visibility="{Binding IsQuickFormStage, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource CardElevatedBrush}"
                                        CornerRadius="8"
                                        Padding="16,12"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding QuickSelectedTitle.Title}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Content="{Binding Strings.QuickChangeTitleButton}"
                                                Click="BackToQuickSearch_Click" />
                                    </Grid>
                                </Border>

                                <!-- 상태 & 온기 2-Column Row -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Strings.TimelineFilterStatusLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Strings.QuickStatusDoneBtn}" Click="SetQuickStatusDone_Click" Margin="0,0,6,6" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Strings.QuickStatusInProgressBtn}" Click="SetQuickStatusInProgress_Click" Margin="0,0,6,6" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Strings.QuickStatusWishlistBtn}" Click="SetQuickStatusWishlist_Click" Margin="0,0,0,6" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Strings.QuickWarmthLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Strings.QuickFeelingSatisfiedBtn}" Click="SetQuickFeelingSatisfied_Click" Margin="0,0,6,6" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Strings.QuickFeelingNeutralBtn}" Click="SetQuickFeelingNeutral_Click" Margin="0,0,6,6" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Strings.QuickFeelingDisappointedBtn}" Click="SetQuickFeelingDisappointed_Click" Margin="0,0,0,6" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 날짜 / 플랫폼 / 장소 / 상황 4-Column Desktop Row -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Strings.QuickWhenInputLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource OttlineTextBoxStyle}" Text="{Binding QuickWatchedOn, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Strings.TimelineFilterPlatformLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6" />
                                        <ComboBox IsEditable="True"
                                                  ItemsSource="{Binding QuickPlatformOptions}"
                                                  Text="{Binding QuickPlatform, UpdateSourceTrigger=PropertyChanged}"
                                                  Padding="10,7" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{Binding Strings.QuickPlaceInputLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding QuickPlaceComboOptions}"
                                                  SelectedIndex="{Binding QuickPlaceComboIndex}"
                                                  Padding="10,7" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="{Binding Strings.QuickOccasionInputLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding QuickOccasionComboOptions}"
                                                  SelectedIndex="{Binding QuickOccasionComboIndex}"
                                                  Padding="10,7" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding Strings.QuickNoteInputLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource OttlineTextBoxStyle}"
                                         Text="{Binding QuickNote, UpdateSourceTrigger=PropertyChanged}"
                                         Height="96"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding QuickSpoiler}" Content="{Binding Strings.SpoilerCheckLabel}" Margin="0,0,16,0" />
                                        <CheckBox IsChecked="{Binding QuickShareTogether}" Content="{Binding Strings.ShareTogetherCheckLabel}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource PrimaryActionButtonStyle}"
                                            Content="{Binding Strings.QuickSaveToTimelineBtn}"
                                            Padding="22,11"
                                            Click="CommitQuickRecord_Click" />
                                </Grid>
                            </StackPanel>

                            <!-- STAGE 3: SAVED -->
                            <StackPanel Visibility="{Binding IsQuickSavedStage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Strings.QuickSavedBannerText}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="0,4,0,16" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                            Content="{Binding Strings.DetailShareCardButton}"
                                            Click="ExportSavedQuickShareCard_Click"
                                            Margin="0,0,10,0" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Strings.QuickKeepPolishingBtn}"
                                            Click="EditSavedQuickRecord_Click"
                                            Margin="0,0,10,0" />
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Content="{Binding Strings.CommonClose}"
                                            Click="CloseQuickRecord_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- =========================================================================
                 MODAL OVERLAY 3: WRITE NEW TOGETHER DISCUSSION MODAL
                 ========================================================================= -->
            <Border Background="{DynamicResource OverlayScrimBrush}"
                    Visibility="{Binding IsWriteDiscussionOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource CardBorderStyle}"
                        Width="640"
                        Padding="28"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Strings.DiscussionNewModalTitle}" FontSize="20" FontWeight="Bold" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="{Binding Strings.CommonCloseWithX}" Click="CloseWriteDiscussion_Click" />
                        </Grid>
                        <TextBlock Text="{Binding Strings.DiscussionTitleLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource OttlineTextBoxStyle}"
                                 Text="{Binding NewDiscussionTitleQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Strings.DiscussionBodyLabel}" FontSize="12" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource OttlineTextBoxStyle}"
                                 Text="{Binding NewDiscussionBody, UpdateSourceTrigger=PropertyChanged}"
                                 Height="110"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,14" />
                        <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                Content="{Binding Strings.DiscussionSubmitBtn}"
                                HorizontalAlignment="Right"
                                Click="SubmitNewDiscussion_Click" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- =========================================================================
                 MODAL OVERLAY 4: SHARE SHEET MODAL (ShareBottomSheet.tsx + Windows Share)
                 ========================================================================= -->
            <Border Background="{DynamicResource OverlayScrimBrush}"
                    Visibility="{Binding IsShareSheetOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource CardBorderStyle}"
                        Width="880"
                        MaxHeight="820"
                        Padding="28,24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Strings.ShareSheetTitle}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <TextBlock Text="{Binding Strings.ShareSheetSubtitle}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Content="{Binding Strings.CommonCloseWithX}"
                                    Click="CloseShareSheet_Click" />
                        </Grid>

                        <!-- 2-Column Body (ShareBottomSheet.tsx: Left Preview + Options | Right 320px Actions) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Card Preview + Checkboxes + Ratio Selector -->
                            <StackPanel Grid.Column="0">
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <Border Width="260"
                                            MaxHeight="440"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Center"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <Image Source="{Binding SharePreviewImage}"
                                               Stretch="Uniform" />
                                    </Border>
                                </Border>

                                <!-- Toggles: 온기 표시 / 한 줄 메모 표시 / 내 프로필 서명 넣기 -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,10">
                                    <CheckBox IsChecked="{Binding ShareShowRating}"
                                              Content="{Binding Strings.ShareShowRatingLabel}"
                                              FontSize="13"
                                              Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                              Margin="0,0,18,0" />
                                    <CheckBox IsChecked="{Binding ShareShowNote}"
                                              Content="{Binding Strings.ShareShowNoteLabel}"
                                              FontSize="13"
                                              Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                              Margin="0,0,18,0" />
                                    <CheckBox IsChecked="{Binding ShareShowSignature}"
                                              Content="{Binding Strings.ShareShowSignatureLabel}"
                                              FontSize="13"
                                              Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                </StackPanel>

                                <!-- Ratio Toggle: 스토리 (9:16) / 피드 (4:5) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Strings.ShareRatioLabel}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Strings.ShareRatioStoryBtn}"
                                            Padding="14,7"
                                            Margin="0,0,8,0"
                                            Click="ShareSheetFormatStory_Click" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Strings.ShareRatioFeedBtn}"
                                            Padding="14,7"
                                            Click="ShareSheetFormatFeed_Click" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right Column: Windows Native Share / Copy Clipboard / Download PNG -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <!-- 1) Primary: Windows 공유하기 (DataTransferManager Native Share UI) -->
                                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                        MinHeight="48"
                                        Padding="16,12"
                                        Margin="0,0,0,10"
                                        HorizontalContentAlignment="Center"
                                        Click="ShareSheetNativeShare_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Stroke="#0F0F0F"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Margin="0,0,8,0"
                                              Data="M 18,8 A 3,3 0 1 0 15,5 A 3,3 0 0 0 18,8 Z M 6,15 A 3,3 0 1 0 3,12 A 3,3 0 0 0 6,15 Z M 18,22 A 3,3 0 1 0 15,19 A 3,3 0 0 0 18,22 Z M 8.59,13.51 L 15.42,17.49 M 15.41,6.51 L 8.59,10.49" />
                                        <TextBlock Text="{Binding Strings.ShareWindowsNativeBtn}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 2) Secondary: 클립보드에 카드 이미지 복사 -->
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="48"
                                        Padding="16,12"
                                        Margin="0,0,0,10"
                                        HorizontalContentAlignment="Center"
                                        Click="ShareSheetCopyClipboard_Click">
                                    <TextBlock Text="{Binding Strings.ShareCopyClipboardBtn}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Button>

                                <!-- 3) Secondary: 이미지 저장 (PNG) -->
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="48"
                                        Padding="16,12"
                                        Margin="0,0,0,12"
                                        HorizontalContentAlignment="Center"
                                        Click="ShareSheetSavePng_Click">
                                    <TextBlock Text="{Binding Strings.ShareSavePngBtn}"
                                               FontSize="14.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                </Button>

                                <TextBlock Text="{Binding ShareSizeLabel}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="2,2,0,0" />
                                <TextBlock Text="{Binding Strings.ShareWindowsHint}"
                                           FontSize="11.5"
                                           LineHeight="18"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="2,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- =========================================================================
                 TOAST NOTIFICATION
                 ========================================================================= -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,32,28"
                    Background="{DynamicResource BrandNavyBrush}"
                    CornerRadius="8"
                    Padding="18,12"
                    Cursor="Hand"
                    MouseLeftButtonUp="Toast_Click"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="#F8F6F2"
                           FontSize="13.5"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- =========================================================================
             FULL-WINDOW EDITORIAL INTRO SPLASH OVERLAY (OttlineIntroSplashOverlay 1:1)
             ========================================================================= -->
        <Grid x:Name="IntroOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Panel.ZIndex="1000"
              ClipToBounds="True"
              Visibility="Collapsed"
              Background="{DynamicResource BackgroundBrush}"
              Cursor="Hand"
              MouseLeftButtonUp="IntroOverlay_Click"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IntroOverlayScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- Subtle warm radial glow behind the brand symbol -->
            <Ellipse x:Name="SplashRadialGlow"
                     Width="580"
                     Height="580"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0,0,0,80"
                     Opacity="0"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#1AFF9933" Offset="0.0" />
                        <GradientStop x:Name="SplashGlowMidStop" Color="#0D1E4D8C" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="32,0"
                        IsHitTestVisible="False">
                <!-- Animated Stroke-Drawing Brand Symbol -->
                <Grid x:Name="SplashMarkContainer"
                      Width="84"
                      Height="84"
                      HorizontalAlignment="Center"
                      Opacity="0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="SplashMarkScale" ScaleX="0.86" ScaleY="0.86" />
                    </Grid.RenderTransform>
                    <Viewbox Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="96" Height="96">
                            <Path x:Name="SplashBookStrokePath"
                                  Stroke="{DynamicResource BrandMarkBrush}"
                                  StrokeThickness="8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Path x:Name="SplashPlayFillPath"
                                  Data="M 15,49 L 36.5,62.75 L 15,76.5 Z"
                                  Fill="{DynamicResource AccentOrangeBrush}"
                                  Opacity="0" />
                            <Path x:Name="SplashPlayStrokePath"
                                  Stroke="{DynamicResource BrandMarkBrush}"
                                  StrokeThickness="8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Grid>

                <!-- Wordmark & Tagline + Editorial Copy + 3-Dot Timeline -->
                <StackPanel x:Name="SplashCopyPanel"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="SplashCopyTranslate" Y="14" />
                    </StackPanel.RenderTransform>

                    <TextBlock Text="ottline"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrandMarkBrush}"
                               HorizontalAlignment="Center" />

                    <StackPanel x:Name="SplashTaglineRow"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0" />

                    <Border CornerRadius="14"
                            Background="{DynamicResource CardElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="12,5"
                            Margin="0,26,0,0"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="{DynamicResource AccentOrangeBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SplashEyebrowText}"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding SplashMessageText}"
                               FontSize="15"
                               LineHeight="24"
                               LineStackingStrategy="BlockLineHeight"
                               FontWeight="Medium"
                               Foreground="{DynamicResource ForegroundBrush}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />

                    <Canvas Width="112"
                            Height="10"
                            HorizontalAlignment="Center"
                            Margin="0,32,0,0">
                        <Line X1="6" Y1="5" X2="106" Y2="5"
                              Stroke="{DynamicResource BorderStrongBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Line x:Name="SplashTimelineActiveLine"
                              X1="6" Y1="5" X2="6" Y2="5"
                              Stroke="{DynamicResource AccentOrangeBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Ellipse Width="5" Height="5" Canvas.Left="3.5" Canvas.Top="2.5" Fill="{DynamicResource BorderStrongBrush}" />
                        <Ellipse Width="5" Height="5" Canvas.Left="53.5" Canvas.Top="2.5" Fill="{DynamicResource BorderStrongBrush}" />
                        <Ellipse Width="5" Height="5" Canvas.Left="103.5" Canvas.Top="2.5" Fill="{DynamicResource BorderStrongBrush}" />
                        <Ellipse x:Name="SplashDot1" Width="7" Height="7" Canvas.Left="2.5" Canvas.Top="1.5" Fill="{DynamicResource AccentOrangeBrush}" />
                        <Ellipse x:Name="SplashDot2" Width="7" Height="7" Canvas.Left="52.5" Canvas.Top="1.5" Fill="{DynamicResource AccentOrangeBrush}" Visibility="Collapsed" />
                        <Ellipse x:Name="SplashDot3" Width="7" Height="7" Canvas.Left="102.5" Canvas.Top="1.5" Fill="{DynamicResource AccentOrangeBrush}" Visibility="Collapsed" />
                    </Canvas>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
